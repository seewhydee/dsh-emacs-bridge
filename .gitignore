# Build output and dependency installs (keep the source; ignore the artifacts).
# `node_modules` without a trailing slash so it also matches the symlinked
# dev node_modules (a symlink is not a directory for gitignore matching).
node_modules
lib/

# A workspace-local pnpm store (used when the user store is outside the sandbox).
.pnpm-store/

# Dependency lockfile: a publishable plugin/library — consumers resolve their
# own deps and never use a transitive dependency's lockfile.
pnpm-lock.yaml

# Emacs artifacts.
.#*
*~
*.elc

# Package/release staging and outputs (`make package`, `make release`).
/.package/
/.release/
/dsh-bridge-*.tar
/dsh-plugin/dsh-emacs-bridge-*.tgz
/dsh-plugin/emacs/
/dsh-plugin/.emacs-stage-*/

# Working plan files (not part of the committed repo).
phase-*.md
*-plan.md
